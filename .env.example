# =====================================================================
# .env.example — copy to .env for local runs, store in GitHub Secrets
# for production. NEVER commit the real .env.
# =====================================================================

# --- Sheet ---
# The spreadsheet ID from the URL (the long string between /d/ and /edit).
SHEET_ID=1vsJkdHva1TFpm0JyXFxek16J3PxkZgfGHMhL_Lu5EF8

# Service-account JSON, single-line. Create at console.cloud.google.com
# → IAM & Admin → Service Accounts → Keys → Add Key → JSON. Then share
# the spreadsheet with the service-account email (Editor access).
# In GitHub Secrets, paste the entire JSON as one secret named
# GOOGLE_SERVICE_ACCOUNT_JSON. Locally: export it as a file path.
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# --- LLMs (free tiers) ---
# Get from https://aistudio.google.com/apikey  (no credit card)
GEMINI_API_KEY=

# Get from https://console.groq.com/keys  (no credit card)
GROQ_API_KEY=

# --- Telegram ---
# Reuse your existing bot token. /newbot via @BotFather if you need
# a fresh one. Chat ID is the numeric ID of YOUR account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=959573065

# --- LinkedIn ---
# Three-legged-OAuth access token with w_member_social scope. Tokens
# expire every 60 days; see docs/RUNBOOK.md for refresh procedure.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:qGqiI6OZqF
EPISODES_PORTFOLIO_URL=https://alok-munshi-portfolio.vercel.app/money-diaries

# --- Cloudflare Worker (set on the Worker, not in this repo) ---
# These are environment variables on the Worker side only.
# WORKER_TELEGRAM_SECRET=long-random-string-set-on-bot-webhook
# WORKER_GITHUB_TOKEN=fine-grained-PAT-with-actions-write-only
# WORKER_GITHUB_OWNER=your-github-username
# WORKER_GITHUB_REPO=arjun-money-diaries
# WORKER_AUTHORIZED_CHAT_ID=959573065
